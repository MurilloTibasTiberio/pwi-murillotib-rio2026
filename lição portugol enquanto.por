programa
{
	
	funcao inicio()
	{
		inteiro num, produto, cont
		cont = 0
		enquanto(cont<5)
		{
			escreva("Digite um número: ")
			leia(num)
			produto = num*3
			escreva("Contador = ",cont, " - Valor da multiplicação por 3: ", produto, "\n")
			cont = cont + 1
		}
	}
}
