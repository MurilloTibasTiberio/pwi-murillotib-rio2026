programa
{
	
	funcao inicio()
	{
		inteiro canal
		
		escreva("Entre com um dos canal: ")
		
		leia(canal)
		escolha(canal)
		{
			caso 2:
			escreva("Voce está sintonizado no canal Band")
			pare

			caso 4:
			escreva("Voce está sintonizado no canal SBT")
			pare

			caso 5:
			escreva("Voce está sintonizado no canal da Globo")
			pare

			caso 7:
			escreva("Voce está sintonizado no canal da Record")
			pare

			caso 9:
			escreva("Voce está sintonizado no canal da Manchete")
			pare

			caso 11:
			escreva("Voce está sintonizado no canal da Gazeta")
			pare

			caso contrario:
			escreva("Canal não encontrado ou inválido!")
		}
	}
}
